# =============================================================================
# 换行符统一为 LF
#
# 这些文件会被拷进 Linux 容器里执行，如果带 CRLF 会直接报错：
#   bash: /app/scripts/healthcheck.sh: $'\r': command not found
#
# 在 Windows 上（core.autocrlf=true）克隆时，默认会把文本文件转成 CRLF，
# 所以这里显式钉死 eol=lf，保证任何平台上检出的都是 LF。
# =============================================================================

*.sh         text eol=lf
Dockerfile   text eol=lf
